{
  "name": "stamps-bulk-generator",
  "version": "1.0.0",
  "description": "STAMPS Sekuriti Bulk XML Generator - Desktop Application",
  "main": "src-main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node server.js",
    "build": "electron-builder",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "Ameer Shafiq",
    "email": "ameershafiq010@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "open": "^9.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1",
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.stamps.bulkgenerator",
    "productName": "STAMPS Bulk Generator",
    "copyright": "Copyright © 2024 Ameer Shafiq",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src-main/**/*",
      "renderer/**/*",
      "data/**/*",
      "server.js",
      "template-generator.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "publisherName": "Ameer Shafiq"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STAMPS Bulk Generator",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "installerHeaderIcon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "stamps-bulk-generator"
    }
  }
}
